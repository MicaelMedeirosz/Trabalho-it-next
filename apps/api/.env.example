PORT=4000
DATABASE_URL="postgresql://postgres:postgres@db:5432/trabalho_it_next"
STORAGE_DIR="/app/storage"
JWT_SECRET="replace-with-random-secret-at-least-32-bytes"
JWT_EXPIRES_IN="8h"
ADMIN_REGISTER_CODE=ADMIN2026@
MAX_FILE_SIZE_BYTES=20971520
MAX_FILES_PER_UPLOAD=10
CORS_ORIGIN="http://localhost:5173"

# Desenvolvimento local: docker compose up -d db mailpit
WEB_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="ITNEXT <nao-responda@itnext.local>"
# Para SMTP real, configure também SMTP_USER e SMTP_PASSWORD.
